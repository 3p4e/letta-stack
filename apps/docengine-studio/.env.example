# Copy to .env and fill in. Never commit the real .env.
DOCENGINE_API_KEY=            # required: the Line B DocEngine shared key
LETTA_API_KEY=                # optional: advisory lane
LETTA_ADVISORY_AGENT=gf_app_assistant
RAGFLOW_ENDPOINT=             # e.g. http://ragflow-ragflow-cpu-1:9380 (official lane)
RAGFLOW_API_KEY=              # official lane is unavailable until set
STUDIO_API_KEY=               # optional: shared key for direct/dev access
STUDIO_MODEL_PROVIDER_READY=0 # set to 1 only once a model provider is wired
KVM4_REVERSE_DNS=             # host suffix for the Traefik rule
