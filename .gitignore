# Standing rule: no secrets, ever (env-var names only)
secrets.env
cookies.txt
*.env
!*.env.example
# local build junk
__pycache__/
*.pyc
.DS_Store

# upstream woff2 cache for the QCSP 001 font subsetting — refetched on demand
ingestion/coa_track/letta-imb-coas/.fontcache/

# QCAR figure intermediates — regenerated by build_qc_activity_report.py
ingestion/coa_track/letta-imb-coas/reports/_fig_*.png

# Personal Claude Code settings — may contain credentials
.claude/settings.local.json

# eCoA runner working state — rebuilt from the corpus
.env
ingestion/ecoa_runner/_tranche_records.json
ingestion/ecoa_runner/held_ingest.json
ingestion/ecoa_runner/ecoa.sqlite
ingestion/ecoa_runner/decisions.tsv

# Artifact-page intermediates — extract_artifact_data.py writes one per workbook
# version, and build_artifact_page.py turns it straight into coq_master_vN.html.
# Neither is a source: both are one command away from the workbook, and no
# earlier vN_data.json was ever committed.
deliverables/qc_gap_analysis/tracker/v*_data.json

# the per-sheet PDFs print_coq_pdfs.py renders before merging — scratch, not a deliverable
deliverables/qc_gap_analysis/drafts/.pages/

# Self-contained HTML exports: generated by deliverables/qc_gap_analysis/build_selfcontained.py
# from the issued documents, and reproducible from them. ~600 KB a file because the subset
# fonts travel inside each one, so the set is not carried in the repository.
deliverables/qc_gap_analysis/SELFCONTAINED/

# The applier keeps one safety copy of the register beside it; it is not a deliverable
deliverables/qc_gap_analysis/*.json.bak
deliverables/qc_gap_analysis/design_handoff/out/_findings_all.txt
