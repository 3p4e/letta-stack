# Copy to .env on KVM4 and fill in. NEVER commit .env.
# Generate the three local secrets with:  openssl rand -hex 32
LITELLM_MASTER_KEY=sk-CHANGE-ME-LONG-RANDOM
LITELLM_SALT_KEY=sk-CHANGE-ME-LONG-RANDOM      # encrypts credentials stored in Postgres; set once, never rotate
LITELLM_DB_PASSWORD=CHANGE-ME-LONG-RANDOM

# Providers measured working 2026-10-10
OPENAI_API_KEY=
OPEN_ROUTER_API_KEY=
ANTHROPIC_API_KEY=            # the sk-ant-usr- key; usable only with the anthropic-workspace-id header,
                              # which config.yaml sends per deployment (wrkspc_01KgrPQHQPyBxATLNrmzQkPn)
VOYAGE_API_KEY=

# Legacy `gemini-flash` rotation (kept from main); free tier, expect 429s - the router rotates
AZ_GEMINI_API_KEY=
BN_GEMINI_API=
BN_GOOGLE_GEMINI_API_KEY=
EP_GEMINI_API=
UC_GEMINI_API=
COMETAPI_API_KEY=

# Parked (config.yaml block is commented out until a key is measured working)
#DEEPSEEK_API_KEY=
